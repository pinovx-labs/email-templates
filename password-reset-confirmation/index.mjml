<mjml>
  <mj-head>
    <!-- Import fonts, external files here -->
    <mj-title>Password Reset OTP</mj-title>
    <mj-preview>Password Reset OTP</mj-preview>

    <!-- Define device breakpoint here -->
    <mj-breakpoint width="400px" />
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;600;700;900&display=swap"
    />

    <mj-style inline="inline">
      body { font-family: 'Inter', sans-serif; } .full-width-image { width: 100%
      !important; max-width: 100% !important; } .social-inline { display:
      inline-block !important; vertical-align: middle !important; width: auto
      !important; padding: 0 5px !important; } .social-icons-center {
      text-align: center !important; margin: 0 auto !important; }
      .social-icons-center table { margin: 0 auto !important; } /* Add this for
      floating image */ .floating-image { position: relative !important; }
      .floating-image table { position: absolute !important; bottom: 10px
      !important; right: 20px !important; }.social-icons{ display:flex
      !important;gap:2px !important }
    </mj-style>
  </mj-head>

  <mj-body background-color="white">
    <mj-wrapper background-color="#ffffff" padding="0">
      <!-- body-logo-hero-section -->

      <mj-section padding="0">
        <mj-column width="100%" padding="0"
          ><mj-image
            src="https://res.cloudinary.com/danxk4ua5/image/upload/v1761858920/Banner_image_1_nhvzan.png"
            alt="hero-image"
            width="600px"
            padding="0"
            fluid-on-mobile="true"
            css-class="full-width-image"
        /></mj-column>
      </mj-section>
      <!-- body-logo-hero-section -->

      <!-- start greeting/intro section -->
      <mj-section padding="40px 25px 20px 25px">
        <mj-column>
          <mj-text
            font-family="Inter, Arial, sans-serif"
            font-size="24px"
            font-weight="bold"
            line-height="32px"
            letter-spacing="0"
            color="#333333"
            font-style="medium"
            padding-bottom="20px"
          >
            Your password has been changed.
          </mj-text>

          <mj-text
            padding="20px 0"
            font-weight="400"
            line-height="24px"
            letter-spacing="0"
            font-size="14px"
            color="#333333"
          >
            <span style="font-weight: 600"> Hello {{John}},</span><br />
            <br />
            This is a confirmation that your password has been recently
            changed.<br />
            <br />You can <span style="color: #19ae14">log in</span> with your
            new password. <br />
            <br />
            If you did not change your password recently, please
            <a
              href="mailto:projects@pinovx.com"
              style="
                text-decoration: underline;
                color: #19ae14;
                font-size: 14px;
                line-height: 20px;
                display: inline-block;
              "
              >contact our support team
            </a>
            and they’ll be happy to help you out.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0 25px">
        <mj-column width="60%" vertical-align="bottom">
          <mj-text padding-bottom="40px">
            Thank You, <br /><br />
            <span style="color: #14ae5c; font-weight: 600">PinovX Team</span>
          </mj-text>
        </mj-column>

        <mj-column width="40%" vertical-align="bottom">
          <mj-image
            src="https://res.cloudinary.com/danxk4ua5/image/upload/v1761858912/pngtree-password-reset-illustration-vector-png-image_11523468_1_rferiz.png"
            alt="Decoration"
            width="150px"
            padding="0"
            align="right"
          />
        </mj-column>
      </mj-section>

      <!-- end salutation section -->

      <!-- Divider -->
      <mj-section padding="0 ">
        <mj-column>
          <mj-divider border-width="1px" border-color="#e5e5e5" />
        </mj-column>
      </mj-section>

      <!-- Social Media Icons -->
      <mj-section padding="30px 25px 20px 25px">
        <mj-column>
          <mj-social
            mode="horizontal"
            align="center"
            icon-size="32px"
            inner-padding="4px"
            padding="0 10px"
          >
            <mj-social-element
              name="instagram"
              href="https://www.instagram.com/wearepinovx/"
              background-color="#14ae5c"
              border-radius="16px"
              padding="0 5px"
            >
            </mj-social-element>

            <mj-social-element
              name="linkedin"
              href="https://www.linkedin.com/company/pinov-inc/"
              background-color="#14ae5c"
              border-radius="16px"
              padding="0 5px"
            >
            </mj-social-element>

            <mj-social-element
              name="facebook"
              href="https://www.facebook.com/wearepinovx"
              background-color="#14ae5c"
              border-radius="16px"
              padding="0 5px"
            >
            </mj-social-element>

            <mj-social-element
              src="https://res.cloudinary.com/danxk4ua5/image/upload/v1761837336/Vector_zamib0.png"
              href="https://x.com/wearepinovx"
              background-color="#14ae5c"
              border-radius="16px"
              padding="0 5px"
            >
            </mj-social-element>
          </mj-social>
        </mj-column>
      </mj-section>

      <!-- Divider -->
      <mj-section padding="20px 0 0 0">
        <mj-column>
          <mj-divider border-width="1px" border-color="#e5e5e5" />
        </mj-column>
      </mj-section>

      <!-- Copyright -->
      <mj-section padding="20px 25px 10px 25px">
        <mj-column>
          <mj-text
            font-size="11px"
            color="#777777"
            align="center"
            line-height="17px"
          >
            © {{currentYear}} PinovX. All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Disclaimer -->
      <mj-section padding="0 25px 20px 25px">
        <mj-column>
          <mj-text
            font-size="11px"
            color="#777777"
            align="center"
            line-height="17px"
          >
            You are receiving this email because you are registering to join the
            PinovX platform. This also shows that you agree to our Terms of Use
            and Privacy Policy.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer Links -->
      <mj-section padding="0 25px 30px 25px">
        <mj-group>
          <mj-column width="33.33%">
            <mj-text
              font-size="11px"
              align="center"
              padding="5px 0"
              line-height="17px"
            >
              <a
                href="https://pinovx.com/privacy-policy"
                style="color: #555555; text-decoration: underline"
              >
                Privacy Policy
              </a>
            </mj-text>
          </mj-column>
          <mj-column width="33.33%">
            <mj-text
              font-size="11px"
              align="center"
              padding="5px 0"
              line-height="17px"
            >
              <a
                href="https://pinovx.com/aml-policy"
                style="color: #555555; text-decoration: underline"
              >
                Aml Policy
              </a>
            </mj-text>
          </mj-column>

          <mj-column width="33.33%">
            <mj-text
              font-size="11px"
              align="center"
              padding="5px 0"
              line-height="17px"
            >
              <a
                href="https://pinovx.com/terms-of-use"
                style="color: #555555; text-decoration: underline"
              >
                Terms of Service
              </a>
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>

      <!-- end policy and terms section -->
    </mj-wrapper>
  </mj-body>
</mjml>
