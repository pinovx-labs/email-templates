<mjml>
  <mj-head>
    <mj-title>PinovX Email Verification</mj-title>
    <mj-preview>Verify your email address with your OTP code</mj-preview>
    <mj-breakpoint width="480px" />

    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <mj-attributes>
      <mj-all
        font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif"
      />
      <mj-text
        font-size="14px"
        color="#333333"
        line-height="22px"
        padding="0"
      />
      <mj-section padding="20px 0" />
      <mj-column padding="0" />
    </mj-attributes>

    <mj-style>
      /* Outlook-safe styles */ .otp-cell { mso-line-height-rule: exactly; } /*
      Responsive adjustments */ @media only screen and (max-width: 480px) {
      .otp-cell { width: 45px !important; height: 48px !important; font-size:
      20px !important; } }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f5f5f5">
    <!-- Email Container -->
    <mj-wrapper background-color="#ffffff" padding="0">
      <!-- Hero Image Section -->
      <mj-section padding="0">
        <mj-column padding="0">
          <mj-image
            src="https://res.cloudinary.com/danxk4ua5/image/upload/v1761837338/Banner_image_z99ggd.png"
            alt="PinovX Email Verification"
            width="600px"
            padding="0"
            fluid-on-mobile="true"
          />
        </mj-column>
      </mj-section>

      <!-- Greeting Section -->
      <mj-section padding="40px 25px 20px 25px">
        <mj-column>
          <mj-text
            font-size="24px"
            font-weight="700"
            line-height="31px"
            color="#333333"
            padding-bottom="20px"
          >
            Hi {{name}},
          </mj-text>

          <mj-text
            font-size="14px"
            font-weight="400"
            line-height="22px"
            color="#555555"
          >
            Here is your One Time Password (OTP). Please enter this code to
            verify your email address for PinovX.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- OTP Section -->
      <mj-section padding="30px 25px" background-color="#ffffff">
        <mj-column>
          <mj-table align="center" padding="0">
            <tr>
              <td
                class="otp-cell"
                align="center"
                valign="middle"
                style="
                  width: 56px;
                  height: 56px;
                  background-color: #892cdc0d;
                  border-radius: 8px;
                  font-size: 24px;
                  font-weight: 600;
                  color: #333333;
                  font-family: Inter, Arial, sans-serif;
                  text-align: center;
                  vertical-align: middle;
                  mso-line-height-rule: exactly;
                  line-height: 56px;
                "
              >
                {0}
              </td>
              <td style="width: 8px"></td>

              <td
                class="otp-cell"
                align="center"
                valign="middle"
                style="
                  width: 56px;
                  height: 56px;
                  background-color: #892cdc0d;
                  border-radius: 8px;
                  font-size: 24px;
                  font-weight: 600;
                  color: #333333;
                  font-family: Inter, Arial, sans-serif;
                  text-align: center;
                  vertical-align: middle;
                  mso-line-height-rule: exactly;
                  line-height: 56px;
                "
              >
                {1}
              </td>
              <td style="width: 8px"></td>

              <td
                class="otp-cell"
                align="center"
                valign="middle"
                style="
                  width: 56px;
                  height: 56px;
                  background-color: #892cdc0d;
                  border-radius: 8px;
                  font-size: 24px;
                  font-weight: 600;
                  color: #333333;
                  font-family: Inter, Arial, sans-serif;
                  text-align: center;
                  vertical-align: middle;
                  mso-line-height-rule: exactly;
                  line-height: 56px;
                "
              >
                {2}
              </td>
              <td style="width: 8px"></td>

              <td
                class="otp-cell"
                align="center"
                valign="middle"
                style="
                  width: 56px;
                  height: 56px;
                  background-color: #892cdc0d;
                  border-radius: 8px;
                  font-size: 24px;
                  font-weight: 600;
                  color: #333333;
                  font-family: Inter, Arial, sans-serif;
                  text-align: center;
                  vertical-align: middle;
                  mso-line-height-rule: exactly;
                  line-height: 56px;
                "
              >
                {3}
              </td>
              <td style="width: 8px"></td>

              <td
                class="otp-cell"
                align="center"
                valign="middle"
                style="
                  width: 56px;
                  height: 56px;
                  background-color: #892cdc0d;
                  border-radius: 8px;
                  font-size: 24px;
                  font-weight: 600;
                  color: #333333;
                  font-family: Inter, Arial, sans-serif;
                  text-align: center;
                  vertical-align: middle;
                  mso-line-height-rule: exactly;
                  line-height: 56px;
                "
              >
                {4}
              </td>
              <td style="width: 8px"></td>

              <td
                class="otp-cell"
                align="center"
                valign="middle"
                style="
                  width: 56px;
                  height: 56px;
                  background-color: #892cdc0d;
                  border-radius: 8px;
                  font-size: 24px;
                  font-weight: 600;
                  color: #333333;
                  font-family: Inter, Arial, sans-serif;
                  text-align: center;
                  vertical-align: middle;
                  mso-line-height-rule: exactly;
                  line-height: 56px;
                "
              >
                {5}
              </td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <!-- Expiry Message -->
      <mj-section padding="0 25px 30px 25px">
        <mj-column>
          <mj-text
            font-size="14px"
            font-weight="400"
            line-height="22px"
            color="#555555"
            align="left"
          >
            This OTP will expire in
            <strong style="color: #333333">{{expiryMinutes}} minutes</strong>.
          </mj-text>

          <mj-text
            font-size="13px"
            font-weight="400"
            line-height="20px"
            color="#777777"
            align="left"
            padding-top="10px"
          >
            If you didn't create an account, please ignore this email.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Salutation -->
      <mj-section padding="0 25px 40px 25px">
        <mj-column>
          <mj-text
            font-size="14px"
            font-weight="400"
            line-height="22px"
            color="#333333"
          >
            Best Regards,<br />
            <span style="color: #14ae5c; font-weight: 500">PinovX Team</span>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Divider -->
      <mj-section padding="0 ">
        <mj-column>
          <mj-divider border-width="1px" border-color="#e5e5e5" />
        </mj-column>
      </mj-section>

      <!-- Social Media Icons -->
      <mj-section padding="30px 25px 20px 25px">
        <mj-column>
          <mj-social
            mode="horizontal"
            align="center"
            icon-size="32px"
            inner-padding="4px"
            padding="0 10px"
          >
            <mj-social-element
              name="instagram"
              href="https://www.instagram.com/wearepinovx/"
              background-color="#14ae5c"
              border-radius="16px"
              padding="0 5px"
            >
            </mj-social-element>

            <mj-social-element
              name="linkedin"
              href="https://www.linkedin.com/company/pinov-inc/"
              background-color="#14ae5c"
              border-radius="16px"
              padding="0 5px"
            >
            </mj-social-element>

            <mj-social-element
              name="facebook"
              href="https://www.facebook.com/wearepinovx"
              background-color="#14ae5c"
              border-radius="16px"
              padding="0 5px"
            >
            </mj-social-element>

            <mj-social-element
              src="https://res.cloudinary.com/danxk4ua5/image/upload/v1761837336/Vector_zamib0.png"
              href="https://x.com/wearepinovx"
              background-color="#14ae5c"
              border-radius="16px"
              padding="0 5px"
            >
            </mj-social-element>
          </mj-social>
        </mj-column>
      </mj-section>

      <!-- Divider -->
      <mj-section padding="20px 0 0 0">
        <mj-column>
          <mj-divider border-width="1px" border-color="#e5e5e5" />
        </mj-column>
      </mj-section>

      <!-- Copyright -->
      <mj-section padding="20px 25px 10px 25px">
        <mj-column>
          <mj-text
            font-size="11px"
            color="#777777"
            align="center"
            line-height="17px"
          >
            © {{currentYear}} PinovX. All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Disclaimer -->
      <mj-section padding="0 25px 20px 25px">
        <mj-column>
          <mj-text
            font-size="11px"
            color="#777777"
            align="center"
            line-height="17px"
          >
            You are receiving this email because you are registering to join the
            PinovX platform. This also shows that you agree to our Terms of Use
            and Privacy Policy.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer Links -->
      <mj-section padding="0 25px 30px 25px">
        <mj-group>
          <mj-column width="33.33%">
            <mj-text
              font-size="11px"
              align="center"
              padding="5px 0"
              line-height="17px"
            >
              <a
                href="https://pinovx.com/privacy-policy"
                style="color: #555555; text-decoration: underline"
              >
                Privacy Policy
              </a>
            </mj-text>
          </mj-column>
          <mj-column width="33.33%">
            <mj-text
              font-size="11px"
              align="center"
              padding="5px 0"
              line-height="17px"
            >
              <a
                href="https://pinovx.com/aml-policy"
                style="color: #555555; text-decoration: underline"
              >
                Aml Policy
              </a>
            </mj-text>
          </mj-column>

          <mj-column width="33.33%">
            <mj-text
              font-size="11px"
              align="center"
              padding="5px 0"
              line-height="17px"
            >
              <a
                href="https://pinovx.com/terms-of-use"
                style="color: #555555; text-decoration: underline"
              >
                Terms of Service
              </a>
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
