<mjml>
  <mj-head>
    <mj-title>Verify your email address</mj-title>
    <mj-preview
      >Let's get you started, quickly verify your email address.</mj-preview
    >

    <mj-breakpoint width="460px" />
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    <mj-font
      name="Barlow"
      href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
    />
    <mj-style inline="inline">
      body { font-family: Barlow, Arial, sans-serif; -webkit-font-smoothing:
      antialiased; } .otp-container { border: 1px dashed #00c853 !important;
      border-radius: 100px !important; background-color: #ffffff !important; }
      .footer-link { color: #00b050 !important; text-decoration: none
      !important; font-size: 11px !important; font-weight: 500 !important; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f4f4f4">
    <mj-wrapper padding="40px 20px 20px 20px">
      <mj-section padding="0 0 30px 0" background-color="transparent">
        <mj-column>
          <mj-image
            src="https://res.cloudinary.com/danxk4ua5/image/upload/v1782468723/Image_ey4moj.png"
            alt="PinovX Logo"
            width="55px"
            align="center"
            padding="0"
          />
        </mj-column>
      </mj-section>

      <mj-section padding="0 0 24px 0" background-color="transparent">
        <mj-column>
          <mj-text
            align="center"
            font-family="'Barlow', Arial, sans-serif"
            font-size="28px"
            color="#000000"
            line-height="36px"
            padding="0"
          >
            Hi <span style="font-weight: 700">there!</span><br />
            Let’s get you started, quickly verify your email address.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section
        background-color="#ffffff"
        padding="50px 40px"
        border-radius="4px"
      >
        <mj-column>
          <mj-text
            align="center"
            font-family="Barlow, Arial, sans-serif"
            font-size="14px"
            color="#333333"
            line-height="22px"
            padding="0 0 40px 0"
          >
            You’re almost set to start enjoying PinovX. Simply use the code
            below to verify your email address and get started.
          </mj-text>
          <!-- Dashed OTP Code Component -->
          <mj-text align="center" padding="10px 0">
            <table
              align="center"
              border="0"
              cellpadding="0"
              cellspacing="0"
              style="
                margin: 0 auto;
                border: 1px dashed #00c853;
                border-radius: 100px;
                background-color: #ffffff;
              "
            >
              <tr>
                <td
                  align="center"
                  style="
                    font-family: 'Barlow', Arial, sans-serif;
                    font-size: 22px;
                    font-weight: 600;
                    color: #3a86ff;
                    letter-spacing: 4px;
                    padding: 14px 45px;
                  "
                >
                  435264
                </td>
              </tr>
            </table>
          </mj-text>

          <mj-text
            align="center"
            font-family="Barlow, Arial, sans-serif"
            font-size="13px"
            color="#333333"
            line-height="18px"
            padding="40px 0 30px 0"
          >
            This one-time password will only be valid for the next 2 minutes.
          </mj-text>

          <mj-text
            align="center"
            font-family="Barlow, Arial, sans-serif"
            font-size="13px"
            color="#333333"
            line-height="20px"
            padding="0"
          >
            If this wasn’t you, please ignore this email or contact our customer
            service center:
            <a
              href="mailto:support@pinovx.com"
              style="color: #00b050; text-decoration: none; font-weight: 500"
              >support@pinovx.com</a
            >
            for further assistance.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="transparent" padding="40px 20px 20px 20px">
        <mj-column>
          <mj-image
            src="https://res.cloudinary.com/danxk4ua5/image/upload/v1782467938/Auto_Layout_Horizontal_mrqzqc.png"
            alt="Pinovx"
            width="160px"
            padding-bottom="20px"
          />

          <mj-text align="center" padding="0px 0px 20px 0px">
            <table
              align="center"
              border="0"
              cellpadding="0"
              cellspacing="0"
              style="margin: 0 auto"
            >
              <tr>
                <td style="padding: 0 8px">
                  <a
                    href="https://www.facebook.com/wearepinovx"
                    target="_blank"
                  >
                    <img
                      src="https://res.cloudinary.com/danxk4ua5/image/upload/v1782467656/Group_vkcu00.png"
                      width="35px"
                      height="35px"
                      style="display: block; border: 0"
                      alt="Facebook"
                    />
                  </a>
                </td>
                <td style="padding: 0 8px">
                  <a
                    href="https://www.instagram.com/wearepinovx/"
                    target="_blank"
                  >
                    <img
                      src="https://res.cloudinary.com/danxk4ua5/image/upload/v1782467675/Group_1_vykvb8.png"
                      width="35px"
                      height="35px"
                      style="display: block; border: 0"
                      alt="Instagram"
                    />
                  </a>
                </td>
                <td style="padding: 0 8px">
                  <a href="https://x.com/wearepinovx" target="_blank">
                    <img
                      src="https://res.cloudinary.com/danxk4ua5/image/upload/v1782467675/Group_2_vbmjxr.png"
                      width="35px"
                      height="35px"
                      style="display: block; border: 0"
                      alt="X"
                    />
                  </a>
                </td>
                <td style="padding: 0 8px">
                  <a href="https://linkedin.com" target="_blank">
                    <img
                      src="https://res.cloudinary.com/danxk4ua5/image/upload/v1782467674/Group_3_ld9lal.png"
                      width="35px"
                      height="35px"
                      style="display: block; border: 0"
                      alt="LinkedIn"
                    />
                  </a>
                </td>
              </tr>
            </table>
          </mj-text>

          <mj-text
            align="center"
            font-family="Barlow, Arial, sans-serif"
            font-size="13px"
            color="#333333"
            line-height="20px"
            padding-bottom="14px"
          >
            Copyright &copy; {{2026}} Pinov Inc. All rights reserved.
          </mj-text>

          <mj-text
            align="center"
            font-family="Barlow, Arial, sans-serif"
            padding="0"
          >
            <a
              href="https://pinovx.com/privacy-policy"
              class="footer-link"
              style="margin: 0 8px"
              >Privacy Policy</a
            >
            <a
              href="https://pinovx.com/terms-of-use"
              class="footer-link"
              style="margin: 0 8px"
              >Terms of Service</a
            >
            <a
              href="https://pinovx.com"
              class="footer-link"
              style="margin: 0 8px"
              >Help Center</a
            >
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
